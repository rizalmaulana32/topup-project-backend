NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=topup_affiliate_platform

# Duitku credentials (Duitku Dashboard - sandbox or production per DUITKU_ENV)
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_ENV=sandbox
DUITKU_CALLBACK_URL=
DUITKU_RETURN_URL=

JWT_SECRET=dev_local_jwt_secret_change_me

# Provider Top-Up vendor: "mock" (default, safe for local/test) or "momo" for
# the real MomoLive Coin Merchant API (see dev-doc/API Terbuka Pedagang Koin MomoLive(1).md)
PROVIDER_TOP_UP_VENDOR=mock
MOMO_MERCHANT_ID=
MOMO_API_SECRET=
MOMO_BASE_URL=https://proxytest.momoindo.com
